# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Editors
.vscode/
*.swp

# Secrets (sollten nie hier landen, aber sicher ist sicher)
.env
*.env

# Laufprotokolle der Evals — Ergebnis eines Laufs, nicht sein Gegenstand.
# antiset-lauf-<pid>.log entsteht bei jedem Anti-Set-Lauf neu. Bisher nie
# eingecheckt (nachgesehen 31.07.2026), aber auch nie ausgeschlossen: ein
# `git add -A` haette sie mitgenommen, und dann liegen im Repo Protokolle
# fremder Laeufe mit Pfaden aus /tmp.
skills/*/evals/antiset-lauf-*.log
skills/*/*/evals/antiset-lauf-*.log

# Punkt-Logs aus Hintergrundlaeufen: `node evals/run-x.mjs > evals/.x.log`.
# Gemessen 03.08.2026: `git add -A skills/` nahm ein solches Log mit in einen
# Commit — 49 Zeilen Lauf-Ausgabe mit Playwright-Stacktrace, mitten im
# Eval-Ordner. Ein Log im Repo ist keine Doku, es altert ab der ersten Sekunde.
skills/*/evals/.*.log
skills/*/*/evals/.*.log
