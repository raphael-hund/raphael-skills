{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@magicui": "https://magicui.design/r/{name}.json",
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@kibo": "https://www.kibo-ui.com/r/{name}.json",
    "@21st": {
      "url": "https://21st.dev/r/{name}",
      "params": {
        "api_key": "${API_KEY_21ST}"
      }
    },
    "@beautifului": "https://www.beautifului.dev/r/{name}.json",
    "@kokonut": "https://kokonutui.com/r/{name}.json",
    "@smoothui": "https://smoothui.dev/r/{name}.json",
    "@uilayouts": "https://www.ui-layouts.com/r/{name}.json"
  }
}