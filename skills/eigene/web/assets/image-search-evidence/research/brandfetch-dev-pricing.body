s7.2 16 16 16l96 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-32 0 0-112c0-8.8-7.2-16-16-16l-48 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l32 0 0 96-32 0zm48-168a24 24 0 1 0 0-48 24 24 0 1 0 0 48z"></path></svg></span></div></div><div class="index-module__9R_cia__value"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B4 index-module-scss-module__LupDFW__variant-primary index-module-scss-module__LupDFW__weight-default"><b class="index-module-scss-module__9VM68q__weight-semibold">By credit card</b> or<!-- --> <b class="index-module-scss-module__9VM68q__weight-semibold">wire transfer</b></p></div></div><div class="index-module__9R_cia__row"><div><div class="index-module-scss-module__1vxd5W__flex index-module-scss-module__1vxd5W__display-flex index-module-scss-module__1vxd5W__direction-row index-module-scss-module__1vxd5W__justify-start index-module-scss-module__1vxd5W__align-center index-module-scss-module__1vxd5W__gap-0 index-module-scss-module__1vxd5W__gap-x-2 index-module-scss-module__1vxd5W__gap-y-0 index-module-scss-module__1vxd5W__wrap-nowrap"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B4 index-module-scss-module__LupDFW__variant-tertiary index-module-scss-module__LupDFW__weight-default">Billing frequency</p><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__theme-textTertiary index-module-scss-module__r1Ax4q__size-sm"><svg data-prefix="fal" data-icon="circle-info" class="svg-inline--fa fa-circle-info " role="img" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M256 32a224 224 0 1 1 0 448 224 224 0 1 1 0-448zm0 480a256 256 0 1 0 0-512 256 256 0 1 0 0 512zM208 352c-8.8 0-16 7.2-16 16s7.2 16 16 16l96 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-32 0 0-112c0-8.8-7.2-16-16-16l-48 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l32 0 0 96-32 0zm48-168a24 24 0 1 0 0-48 24 24 0 1 0 0 48z"></path></svg></span></div></div><div class="index-module__9R_cia__value"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B4 index-module-scss-module__LupDFW__variant-primary index-module-scss-module__LupDFW__weight-default"><b class="index-module-scss-module__9VM68q__weight-semibold">Yearly</b></p></div></div><div class="index-module__9R_cia__row"><div><div class="index-module-scss-module__1vxd5W__flex index-module-scss-module__1vxd5W__display-flex index-module-scss-module__1vxd5W__direction-row index-module-scss-module__1vxd5W__justify-start index-module-scss-module__1vxd5W__align-center index-module-scss-module__1vxd5W__gap-0 index-module-scss-module__1vxd5W__gap-x-2 index-module-scss-module__1vxd5W__gap-y-0 index-module-scss-module__1vxd5W__wrap-nowrap"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B4 index-module-scss-module__LupDFW__variant-tertiary index-module-scss-module__LupDFW__weight-default">Contract length</p><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__theme-textTertiary index-module-scss-module__r1Ax4q__size-sm"><svg data-prefix="fal" data-icon="circle-info" class="svg-inline--fa fa-circle-info " role="img" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M256 32a224 224 0 1 1 0 448 224 224 0 1 1 0-448zm0 480a256 256 0 1 0 0-512 256 256 0 1 0 0 512zM208 352c-8.8 0-16 7.2-16 16s7.2 16 16 16l96 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-32 0 0-112c0-8.8-7.2-16-16-16l-48 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l32 0 0 96-32 0zm48-168a24 24 0 1 0 0-48 24 24 0 1 0 0 48z"></path></svg></span></div></div><div class="index-module__9R_cia__value"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B4 index-module-scss-module__LupDFW__variant-primary index-module-scss-module__LupDFW__weight-default"><b class="index-module-scss-module__9VM68q__weight-semibold">Annual</b> or <b class="index-module-scss-module__9VM68q__weight-semibold">multi-year</b><