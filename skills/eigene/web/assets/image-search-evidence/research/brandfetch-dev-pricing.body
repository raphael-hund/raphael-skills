FW__paragraph index-module-scss-module__LupDFW__level-B4 index-module-scss-module__LupDFW__variant-primary index-module-scss-module__LupDFW__weight-default"><b class="index-module-scss-module__9VM68q__weight-semibold">Dedicated account manager</b></p></div></div><div class="index-module__9R_cia__row"><div><div class="index-module-scss-module__1vxd5W__flex index-module-scss-module__1vxd5W__display-flex index-module-scss-module__1vxd5W__direction-row index-module-scss-module__1vxd5W__justify-start index-module-scss-module__1vxd5W__align-center index-module-scss-module__1vxd5W__gap-0 index-module-scss-module__1vxd5W__gap-x-2 index-module-scss-module__1vxd5W__gap-y-0 index-module-scss-module__1vxd5W__wrap-nowrap"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B4 index-module-scss-module__LupDFW__variant-tertiary index-module-scss-module__LupDFW__weight-default">Enterprise SLAs</p><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__theme-textTertiary index-module-scss-module__r1Ax4q__size-sm"><svg data-prefix="fal" data-icon="circle-info" class="svg-inline--fa fa-circle-info " role="img" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M256 32a224 224 0 1 1 0 448 224 224 0 1 1 0-448zm0 480a256 256 0 1 0 0-512 256 256 0 1 0 0 512zM208 352c-8.8 0-16 7.2-16 16s7.2 16 16 16l96 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-32 0 0-112c0-8.8-7.2-16-16-16l-48 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l32 0 0 96-32 0zm48-168a24 24 0 1 0 0-48 24 24 0 1 0 0 48z"></path></svg></span></div></div><div class="index-module__9R_cia__value"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__theme-textSuccess index-module-scss-module__r1Ax4q__size-sm"><svg data-prefix="fal" data-icon="check" class="svg-inline--fa fa-check " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M441.4 67.1c7.1 5.2 8.7 15.2 3.5 22.4l-280 384c-2.8 3.8-7 6.2-11.7 6.5s-9.2-1.3-12.6-4.6l-136-136c-6.2-6.2-6.2-16.4 0-22.6s16.4-6.2 22.6 0l122.8 122.8 269-368.9c5.2-7.1 15.2-8.7 22.4-3.5z"></path></svg></span></div></div><div class="index-module__9R_cia__row"><div><div class="index-module-scss-module__1vxd5W__flex index-module-scss-module__1vxd5W__display-flex index-module-scss-module__1vxd5W__direction-row index-module-scss-module__1vxd5W__justify-start index-module-scss-module__1vxd5W__align-center index-module-scss-module__1vxd5W__gap-0 index-module-scss-module__1vxd5W__gap-x-2 index-module-scss-module__1vxd5W__gap-y-0 index-module-scss-module__1vxd5W__wrap-nowrap"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B4 index-module-scss-module__LupDFW__variant-tertiary index-module-scss-module__LupDFW__weight-default">Priority brand QA</p><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__theme-textTertiary index-module-scss-module__r1Ax4q__size-sm"><svg data-prefix="fal" data-icon="circle-info" class="svg-inline--fa fa-circle-info " role="img" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M256 32a224 224 0 1 1 0 448 224 224 0 1 1 0-448zm0 480a256 256 0 1 0 0-512 256 256 0 1 0 0 512zM208 352c-8.8 0-16 7.2-16 16s7.2 16 16 16l96 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-32 0 0-112c0-8.8-7.2-16-16-16l-48 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l32 0 0 96-32 0zm48-168a24 24 0 1 0 0-48 24 24 0 1 0 0 48z"></path></svg></span></div></div><div class="index-module__9R_cia__value"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__theme-textSuccess index-module-scss-module__r1Ax4q__size-sm"><svg data-prefix="fal" data-icon="check" class="svg-inline--fa fa-check " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M441.4 67.1c7.1 5.2 8.7 15.2 3.5 22.4l-280 384c-2.8 3.8-7 6.2-11.7 6.5s-9.2-1.3-12.6-4.6l-136-136c-6.2-6.2-6.2-16.4 0-22.6s16.4-6.2 22.6 0l122.8 122.8 269-368.9c5.2-7.1 15.2-8.7 22.4-3.5z"></path></svg></span></div></div></div></div></div></section><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"acceptedAnswer":{"text":"\u003cp\u003eBrand API and Brand Context API each cost 1 credit per call. Each plan includes a monthly credit pool that resets every cycle and doesn\u0026#39;t carry over. Logo API and Brand Search API run on separate quotas and don\u0026#39;t consume credits. See the table above for per-plan limits.\u003c/p\u003e","@type":"Answer"},"name":"How does pricing work?","@type":"Question"},{"acceptedAnswer":{"text":"\u003cp\u003eBrand fetches over your monthly limit are billed at $0.10 each, up to an \u003ca href=\"https://docs.brandfetch.com/brand-api/overview#overage-billing\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eoverage cap\u003c/a\u003e you set. You\u0026#39;ll get usage alerts at 80% and 100%. Logo API and Brand Search API are soft-capped: going over triggers a notification, not a hard stop.\u003c/p\u003e","@type":"Answer"},"name":"What happens when I exceed my quota?","@type":"Question"},{"acceptedAnswer":{"text":"\u003cp\u003eYes, for internal use cases like displaying a logo in your app. Sublicensing the data to your customers or including it in your own API responses requires a specific agreement. \u003ca href=\"https://brandfetch.com/developers/contact/sales\"\u003eContact sales\u003c/a\u003e if that\u0026#39;s your use case.\u003c/p\u003e","@type":"Answer"},"name":"Can I use your data commercially?","@type":"Question"},{"acceptedAnswer":{"text":"\u003cp\u003eYes. The Free plan gives you 100 fetches plus free Logo CDN and Brand Search up to 500K requests/mo each, no credit card required. Enough to test most integrations end-to-end. You can also preview the data on our \u003ca href=\"https://brandfetch.com/developers/playground\"\u003eplayground\u003c/a\u003e.\u003c/p\u003e","@type":"Answer"},"name":"Can I try Brandfetch before I buy?","@type":"Question"},{"acceptedAnswer":{"text":"\u003cp\u003eOver 50 million brands and growing, continuously refreshed from the open web. Our APIs also resolve in real time: any brand with a valid domain returns data, across every industry and region.\u003c/p\u003e","@type":"Answer"},"name":"How many brands do you cover?","@type":"Question"},{"acceptedAnswer":{"text":"\u003cp\u003eNo, but brands can claim and manage their profile directly on \u003ca href=\"https://brandfetch.com\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ebrandfetch.com\u003c/a\u003e, making us the only platform with first-party brand data. Beyond that, our data is aggregated from publicly available sources on the open web.\u003c/p\u003e","@type":"Answer"},"name":"Does Brandfetch obtain each brand's permission?","@type":"Question"},{"acceptedAnswer":{"text":"\u003cp\u003eUse \u003ca href=\"https://brandfetch.com/developers/logo-api\"\u003eLogo API\u003c/a\u003e when you only need a logo, for example to embed a brand mark in your UI. It\u0026#39;s optimized for that, served via a fast CDN, and runs on its own quota separate from credits.\u003cbr\u003e\u003cbr\u003eUse \u003ca href=\"https://brandfetch.com/developers/brand-api\"\u003eBrand API\u003c/a\u003e when you need the full brand record: logos, colors, fonts, firmographics, and more in a single call. Brand API responses can be cached for 30 days to reduce credit usage. Logo API images can be cached locally per our \u003ca href=\"https://docs.brandfetch.com/logo-api/overview#usage-guidelines\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eusage guidelines\u003c/a\u003e.\u003c/p\u003e","@type":"Answer"},"name":"When should I use Logo API vs Brand API?","@type":"Question"},{"acceptedAnswer":{"text":"\u003cp\u003eBrandfetch integrates with several platforms so you can use brand data without writing custom code:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003ca href=\"https://docs.brandfetch.com/mcp/overview\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eMCP\u003c/a\u003e for AI agents and assistants\u003c/li\u003e\u003cli\u003e\u003ca href=\"https://zapier.com/apps/brandfetch/integrations\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eZapier\u003c/a\u003e for automated workflows\u003c/li\u003e\u003cli\u003e\u003ca href=\"https://n8n.io/integrations/brandfetch/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003en8n\u003c/a\u003e for self-hosted automation\u003c/li\u003e\u003cli\u003e\u003ca href=\"https://www.make.com/en/integrations/brandfetch\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eMake.com\u003c/a\u003e for visual workflow building\u003c/li\u003e\u003c/ul\u003e","@type":"Answer"},"name":"What integrations do you offer?","@type":"Question"},{"acceptedAnswer":{"text":"\u003cp\u003eBrand data stays fresh through several mechanisms:\u003c/p\u003e\u003cul\u003e\u003cli\u003eAPI requests trigger a background recrawl if the brand hasn\u0026#39;t been refreshed in 3 months, so the index stays current with usage\u003c/li\u003e\u003cli\u003eClaimed brands are managed directly by their owners, always current\u003c/li\u003e\u003cli\u003eCurated brands are managed by our QA team, who also track rebrands across the web\u003c/li\u003e\u003cli\u003eCrowdsourced updates flow in continuously from users of our plugins and integrations\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eNeed a brand refreshed now? \u003ca href=\"https://brandfetch.com/update?mode=web\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eSubmit a brand update request\u003c/a\u003e.\u003c/p\u003e","@type":"Answer"},"name":"How often do you update your dataset?","@type":"Question"},{"acceptedAnswer":{"text":"\u003cp\u003eLogos are delivered in SVG when available, with PNG conversions for broader compatibility. If SVG isn\u0026#39;t available, you get the highest-quality PNG we can find, with a transparent background. See \u003ca href=\"https://docs.brandfetch.com/reference/brand-api\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eour docs\u003c/a\u003e for more details.\u003c/p\u003e","@type":"Answer"},"name":"What logo formats do you support?","@type":"Question"},{"acceptedAnswer":{"text":"\u003cp\u003eSubmit your request at \u003ca href=\"https://brandfetch.com/update?mode=web\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ebrandfetch.com/update\u003c/a\u003e. Our QA team will update the brand with its latest information.\u003c/p\u003e","@type":"Answer"},"name":"How do I request a brand update?","@type":"Question"},{"acceptedAnswer":{"text":"\u003cp\u003eYes. Qualified startups and nonprofits get 40% off paid plans for the first 12 months. \u003ca href=\"https://brandfetch.com/developers/contact/sales\"\u003eReach out to sales\u003c/a\u003e to apply.\u003c/p\u003e","@type":"Answer"},"name":"Do you offer discounts for startups or nonprofits?","@type":"Question"}]}</script><section class="index-module-scss-module__GUXqXq__section index-module-scss-module__GUXqXq__variant-primary index-module-scss-module__GUXqXq__top-25 index-module-scss-module__GUXqXq__bottom-25"><div class="index-module__TJCJ4G__container index-module__TJCJ4G__size-lg"><div class="index-module-scss-module__1vxd5W__flex index-module-scss-module__1vxd5W__display-flex index-module-scss-module__1vxd5W__direction-row index-module-scss-module__1vxd5W__justify-sm-center index-module-scss-module__1vxd5W__align-center index-module-scss-module__1vxd5W__gap-0 index-module-scss-module__1vxd5W__gap-x-0 index-module-scss-module__1vxd5W__gap-y-0 index-module-scss-module__1vxd5W__wrap-nowrap"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B3 index-module-scss-module__LupDFW__variant-pro index-module-scss-module__LupDFW__weight-semibold index-module-scss-module__LupDFW__transform-uppercase">Frequently asked questions</p></div><div class="index-module-scss-module__szccRa__space-4" aria-hidden="true"></div><div class="index-module-scss-module__1vxd5W__flex index-module-scss-module__1vxd5W__display-flex index-module-scss-module__1vxd5W__direction-sm-column index-module-scss-module__1vxd5W__justify-between index-module-scss-module__1vxd5W__align-center index-module-scss-module__1vxd5W__gap-0 index-module-scss-module__1vxd5W__gap-x-6 index-module-scss-module__1vxd5W__gap-y-4 index-module-scss-module__1vxd5W__wrap-nowrap"><h2 class="index-module-scss-module__WznaLG__level-3 index-module-scss-module__WznaLG__title"><span class="index-module-scss-module__9VM68q__gradient-silver">Your questions answered</span></h2><div class="index-module-scss-module__1vxd5W__flex index-module-scss-module__1vxd5W__display-flex index-module-scss-module__1vxd5W__direction-sm-column index-module-scss-module__1vxd5W__justify-start index-module-scss-module__1vxd5W__align-center index-module-scss-module__1vxd5W__gap-0 index-module-scss-module__1vxd5W__gap-x-4 index-module-scss-module__1vxd5W__gap-y-0 index-module-scss-module__1vxd5W__width-sm-full index-module-scss-module__1vxd5W__wrap-nowrap"><a class="index-module-scss-module__5HxASG__width-sm-full index-module-scss-module__5HxASG__width-flex" href="/developers/contact/sales"><button type="button" class="index-module-scss-module__43-cmG__button index-module-scss-module__43-cmG__variant-secondary index-module-scss-module__43-cmG__size-xs index-module-scss-module__43-cmG__width-sm-full"><span>Have more questions?</span></button></a><a rel="noopener noreferrer" class="index-module-scss-module__5HxASG__width-sm-full index-module-scss-module__5HxASG__width-flex" target="_blank" href="https://claude.ai/new?q=I%20have%20a%20question%20about%20Brandfetch&#x27;s%20developer%20APIs%3A"><button type="button" class="index-module-scss-module__43-cmG__button index-module-scss-module__43-cmG__variant-outlined index-module-scss-module__43-cmG__size-xs index-module-scss-module__43-cmG__width-sm-full"><span><span class="index-module-scss-module__1vxd5W__flex index-module-scss-module__1vxd5W__display-flex index-module-scss-module__1vxd5W__direction-row index-module-scss-module__1vxd5W__justify-start index-module-scss-module__1vxd5W__align-center index-module-scss-module__1vxd5W__gap-0 index-module-scss-module__1vxd5W__gap-x-2 index-module-scss-module__1vxd5W__gap-y-0 index-module-scss-module__1vxd5W__wrap-nowrap"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-md"><svg data-prefix="fab" data-icon="claude" class="svg-inline--fa fa-claude " role="img" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M100.4 340.5l100.7-56.5 1.7-4.9-1.7-2.7-4.9 0-16.8-1-57.5-1.6-49.9-2.1-48.3-2.6-12.2-2.6-11.4-15 1.2-7.5 10.2-6.9 14.7 1.3c18.9 1.3 45.9 3.1 81 5.6l35.2 2.1 52.2 5.4 8.3 0 1.2-3.4-2.8-2.1-2.2-2.1-50.3-34.1-54.4-36-28.5-20.7-15.4-10.5-7.8-9.8-3.4-21.5 14-15.4 18.8 1.3 4.8 1.3 19 14.7 40.7 31.5 53.1 39.1 7.8 6.5 3.1-2.2 .4-1.6-3.5-5.8-28.9-52.2-30.8-53.1-13.7-22-3.6-13.2c-1.3-5.4-2.2-10-2.2-15.5l15.9-21.6 8.8-2.8 21.2 2.8 8.9 7.8 13.2 30.2 21.4 47.5 33.2 64.6 9.7 19.2 5.2 17.8 1.9 5.4 3.4 0 0-3.1 2.7-36.4 5-44.7 4.9-57.5 1.7-16.2 8-19.4 15.9-10.5 12.4 5.9 10.2 14.7-1.4 9.5-6.1 39.5-11.9 61.9-7.8 41.5 4.5 0 5.2-5.2 21-27.8 35.2-44.1 15.5-17.5 18.1-19.3 11.6-9.2 22 0 16.2 24.1-7.3 24.9-22.7 28.7-18.8 24.4-27 36.3-16.8 29 1.6 2.3 4-.4 60.9-13 32.9-5.9 39.3-6.7 17.8 8.3 1.9 8.4-7 17.2-42 10.4-49.2 9.8-73.3 17.3-.9 .7 1 1.3 33 3.1 14.1 .8 34.6 0 64.4 4.8 16.8 11.1 10.1 13.6-1.7 10.4-25.9 13.2c-15.5-3.7-54.4-12.9-116.6-27.7l-28-7-3.9 0 0 2.3 23.3 22.8 42.7 38.6 53.5 49.8 2.7 12.3-6.9 9.7-7.3-1-47-35.4-18.1-15.9-41.1-34.6-2.7 0 0 3.6 9.5 13.9 50 75.2 2.6 23-3.6 7.5-13 4.5-14.2-2.6-29.3-41.1-30.2-46.3-24.4-41.5-3 1.7-14.4 154.8-6.7 7.9-15.5 5.9-13-9.8-6.9-15.9 6.9-31.5 8.3-41.1 6.7-32.7 6.1-40.6 3.6-13.5-.2-.9-3 .4-30.6 42-46.5 62.9-36.8 39.4-8.8 3.5-15.3-7.9 1.4-14.1 8.5-12.6 50.9-64.8 30.7-40.2 19.8-23.2-.1-3.4-1.2 0-135.3 87.8-24.1 3.1-10.4-9.7 1.3-15.9 4.9-5.2 40.7-28-.1 .1 0 .1z"></path></svg></span><span>Ask Claude</span></span></span></button></a></div></div><div class="index-module-scss-module__szccRa__space-10" aria-hidden="true"></div><div class="index-module-scss-module__AmR4nq__grid index-module-scss-module__AmR4nq__align-stretch index-module-scss-module__AmR4nq__columns-2x1fr index-module-scss-module__AmR4nq__columns-md-1fr index-module-scss-module__AmR4nq__gap-x-5"><div class="index-module__BI6UNW__collapse index-module__BI6UNW__variant-primary"><div class="index-module__OW0Mba__collapse-item index-module__OW0Mba__variant-primary"><div class="index-module__OW0Mba__header index-module__OW0Mba__variant-primary" aria-expanded="false" role="button" tabindex="0"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B1 index-module-scss-module__LupDFW__weight-semibold">How does pricing work?</p><span class="index-module__OW0Mba__iconWrapper" aria-hidden="true"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-lg"><svg data-prefix="fal" data-icon="plus" class="svg-inline--fa fa-plus " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M240 48c0-8.8-7.2-16-16-16s-16 7.2-16 16l0 192-192 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l192 0 0 192c0 8.8 7.2 16 16 16s16-7.2 16-16l0-192 192 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-192 0 0-192z"></path></svg></span></span></div><div class="index-module__OW0Mba__body index-module__OW0Mba__variant-primary" aria-label="How does pricing work?" role="region"><div><div><div><p>Brand API and Brand Context API each cost 1 credit per call. Each plan includes a monthly credit pool that resets every cycle and doesn&#39;t carry over. Logo API and Brand Search API run on separate quotas and don&#39;t consume credits. See the table above for per-plan limits.</p></div></div></div></div></div><div class="index-module__OW0Mba__collapse-item index-module__OW0Mba__variant-primary"><div class="index-module__OW0Mba__header index-module__OW0Mba__variant-primary" aria-expanded="false" role="button" tabindex="0"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B1 index-module-scss-module__LupDFW__weight-semibold">What happens when I exceed my quota?</p><span class="index-module__OW0Mba__iconWrapper" aria-hidden="true"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-lg"><svg data-prefix="fal" data-icon="plus" class="svg-inline--fa fa-plus " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M240 48c0-8.8-7.2-16-16-16s-16 7.2-16 16l0 192-192 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l192 0 0 192c0 8.8 7.2 16 16 16s16-7.2 16-16l0-192 192 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-192 0 0-192z"></path></svg></span></span></div><div class="index-module__OW0Mba__body index-module__OW0Mba__variant-primary" aria-label="What happens when I exceed my quota?" role="region"><div><div><div><p>Brand fetches over your monthly limit are billed at $0.10 each, up to an <a href="https://docs.brandfetch.com/brand-api/overview#overage-billing" target="_blank" rel="noopener noreferrer">overage cap</a> you set. You&#39;ll get usage alerts at 80% and 100%. Logo API and Brand Search API are soft-capped: going over triggers a notification, not a hard stop.</p></div></div></div></div></div><div class="index-module__OW0Mba__collapse-item index-module__OW0Mba__variant-primary"><div class="index-module__OW0Mba__header index-module__OW0Mba__variant-primary" aria-expanded="false" role="button" tabindex="0"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B1 index-module-scss-module__LupDFW__weight-semibold">Can I use your data commercially?</p><span class="index-module__OW0Mba__iconWrapper" aria-hidden="true"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-lg"><svg data-prefix="fal" data-icon="plus" class="svg-inline--fa fa-plus " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M240 48c0-8.8-7.2-16-16-16s-16 7.2-16 16l0 192-192 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l192 0 0 192c0 8.8 7.2 16 16 16s16-7.2 16-16l0-192 192 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-192 0 0-192z"></path></svg></span></span></div><div class="index-module__OW0Mba__body index-module__OW0Mba__variant-primary" aria-label="Can I use your data commercially?" role="region"><div><div><div><p>Yes, for internal use cases like displaying a logo in your app. Sublicensing the data to your customers or including it in your own API responses requires a specific agreement. <a href="https://brandfetch.com/developers/contact/sales">Contact sales</a> if that&#39;s your use case.</p></div></div></div></div></div><div class="index-module__OW0Mba__collapse-item index-module__OW0Mba__variant-primary"><div class="index-module__OW0Mba__header index-module__OW0Mba__variant-primary" aria-expanded="false" role="button" tabindex="0"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B1 index-module-scss-module__LupDFW__weight-semibold">Can I try Brandfetch before I buy?</p><span class="index-module__OW0Mba__iconWrapper" aria-hidden="true"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-lg"><svg data-prefix="fal" data-icon="plus" class="svg-inline--fa fa-plus " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M240 48c0-8.8-7.2-16-16-16s-16 7.2-16 16l0 192-192 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l192 0 0 192c0 8.8 7.2 16 16 16s16-7.2 16-16l0-192 192 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-192 0 0-192z"></path></svg></span></span></div><div class="index-module__OW0Mba__body index-module__OW0Mba__variant-primary" aria-label="Can I try Brandfetch before I buy?" role="region"><div><div><div><p>Yes. The Free plan gives you 100 fetches plus free Logo CDN and Brand Search up to 500K requests/mo each, no credit card required. Enough to test most integrations end-to-end. You can also preview the data on our <a href="https://brandfetch.com/developers/playground">playground</a>.</p></div></div></div></div></div><div class="index-module__OW0Mba__collapse-item index-module__OW0Mba__variant-primary"><div class="index-module__OW0Mba__header index-module__OW0Mba__variant-primary" aria-expanded="false" role="button" tabindex="0"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B1 index-module-scss-module__LupDFW__weight-semibold">How many brands do you cover?</p><span class="index-module__OW0Mba__iconWrapper" aria-hidden="true"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-lg"><svg data-prefix="fal" data-icon="plus" class="svg-inline--fa fa-plus " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M240 48c0-8.8-7.2-16-16-16s-16 7.2-16 16l0 192-192 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l192 0 0 192c0 8.8 7.2 16 16 16s16-7.2 16-16l0-192 192 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-192 0 0-192z"></path></svg></span></span></div><div class="index-module__OW0Mba__body index-module__OW0Mba__variant-primary" aria-label="How many brands do you cover?" role="region"><div><div><div><p>Over 50 million brands and growing, continuously refreshed from the open web. Our APIs also resolve in real time: any brand with a valid domain returns data, across every industry and region.</p></div></div></div></div></div><div class="index-module__OW0Mba__collapse-item index-module__OW0Mba__variant-primary"><div class="index-module__OW0Mba__header index-module__OW0Mba__variant-primary" aria-expanded="false" role="button" tabindex="0"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B1 index-module-scss-module__LupDFW__weight-semibold">Does Brandfetch obtain each brand&#x27;s permission?</p><span class="index-module__OW0Mba__iconWrapper" aria-hidden="true"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-lg"><svg data-prefix="fal" data-icon="plus" class="svg-inline--fa fa-plus " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M240 48c0-8.8-7.2-16-16-16s-16 7.2-16 16l0 192-192 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l192 0 0 192c0 8.8 7.2 16 16 16s16-7.2 16-16l0-192 192 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-192 0 0-192z"></path></svg></span></span></div><div class="index-module__OW0Mba__body index-module__OW0Mba__variant-primary" aria-label="Does Brandfetch obtain each brand&#x27;s permission?" role="region"><div><div><div><p>No, but brands can claim and manage their profile directly on <a href="https://brandfetch.com" target="_blank" rel="noopener noreferrer">brandfetch.com</a>, making us the only platform with first-party brand data. Beyond that, our data is aggregated from publicly available sources on the open web.</p></div></div></div></div></div></div><div class="index-module__BI6UNW__collapse index-module__BI6UNW__variant-primary"><div class="index-module__OW0Mba__collapse-item index-module__OW0Mba__variant-primary"><div class="index-module__OW0Mba__header index-module__OW0Mba__variant-primary" aria-expanded="false" role="button" tabindex="0"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B1 index-module-scss-module__LupDFW__weight-semibold">When should I use Logo API vs Brand API?</p><span class="index-module__OW0Mba__iconWrapper" aria-hidden="true"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-lg"><svg data-prefix="fal" data-icon="plus" class="svg-inline--fa fa-plus " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M240 48c0-8.8-7.2-16-16-16s-16 7.2-16 16l0 192-192 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l192 0 0 192c0 8.8 7.2 16 16 16s16-7.2 16-16l0-192 192 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-192 0 0-192z"></path></svg></span></span></div><div class="index-module__OW0Mba__body index-module__OW0Mba__variant-primary" aria-label="When should I use Logo API vs Brand API?" role="region"><div><div><div><p>Use <a href="https://brandfetch.com/developers/logo-api">Logo API</a> when you only need a logo, for example to embed a brand mark in your UI. It&#39;s optimized for that, served via a fast CDN, and runs on its own quota separate from credits.<br><br>Use <a href="https://brandfetch.com/developers/brand-api">Brand API</a> when you need the full brand record: logos, colors, fonts, firmographics, and more in a single call. Brand API responses can be cached for 30 days to reduce credit usage. Logo API images can be cached locally per our <a href="https://docs.brandfetch.com/logo-api/overview#usage-guidelines" target="_blank" rel="noopener noreferrer">usage guidelines</a>.</p></div></div></div></div></div><div class="index-module__OW0Mba__collapse-item index-module__OW0Mba__variant-primary"><div class="index-module__OW0Mba__header index-module__OW0Mba__variant-primary" aria-expanded="false" role="button" tabindex="0"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B1 index-module-scss-module__LupDFW__weight-semibold">What integrations do you offer?</p><span class="index-module__OW0Mba__iconWrapper" aria-hidden="true"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-lg"><svg data-prefix="fal" data-icon="plus" class="svg-inline--fa fa-plus " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M240 48c0-8.8-7.2-16-16-16s-16 7.2-16 16l0 192-192 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l192 0 0 192c0 8.8 7.2 16 16 16s16-7.2 16-16l0-192 192 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-192 0 0-192z"></path></svg></span></span></div><div class="index-module__OW0Mba__body index-module__OW0Mba__variant-primary" aria-label="What integrations do you offer?" role="region"><div><div><div><p>Brandfetch integrates with several platforms so you can use brand data without writing custom code:</p><ul><li><a href="https://docs.brandfetch.com/mcp/overview" target="_blank" rel="noopener noreferrer">MCP</a> for AI agents and assistants</li><li><a href="https://zapier.com/apps/brandfetch/integrations" target="_blank" rel="noopener noreferrer">Zapier</a> for automated workflows</li><li><a href="https://n8n.io/integrations/brandfetch/" target="_blank" rel="noopener noreferrer">n8n</a> for self-hosted automation</li><li><a href="https://www.make.com/en/integrations/brandfetch" target="_blank" rel="noopener noreferrer">Make.com</a> for visual workflow building</li></ul></div></div></div></div></div><div class="index-module__OW0Mba__collapse-item index-module__OW0Mba__variant-primary"><div class="index-module__OW0Mba__header index-module__OW0Mba__variant-primary" aria-expanded="false" role="button" tabindex="0"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B1 index-module-scss-module__LupDFW__weight-semibold">How often do you update your dataset?</p><span class="index-module__OW0Mba__iconWrapper" aria-hidden="true"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-lg"><svg data-prefix="fal" data-icon="plus" class="svg-inline--fa fa-plus " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M240 48c0-8.8-7.2-16-16-16s-16 7.2-16 16l0 192-192 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l192 0 0 192c0 8.8 7.2 16 16 16s16-7.2 16-16l0-192 192 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-192 0 0-192z"></path></svg></span></span></div><div class="index-module__OW0Mba__body index-module__OW0Mba__variant-primary" aria-label="How often do you update your dataset?" role="region"><div><div><div><p>Brand data stays fresh through several mechanisms:</p><ul><li>API requests trigger a background recrawl if the brand hasn&#39;t been refreshed in 3 months, so the index stays current with usage</li><li>Claimed brands are managed directly by their owners, always current</li><li>Curated brands are managed by our QA team, who also track rebrands across the web</li><li>Crowdsourced updates flow in continuously from users of our plugins and integrations</li></ul><p>Need a brand refreshed now? <a href="https://brandfetch.com/update?mode=web" target="_blank" rel="noopener noreferrer">Submit a brand update request</a>.</p></div></div></div></div></div><div class="index-module__OW0Mba__collapse-item index-module__OW0Mba__variant-primary"><div class="index-module__OW0Mba__header index-module__OW0Mba__variant-primary" aria-expanded="false" role="button" tabindex="0"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B1 index-module-scss-module__LupDFW__weight-semibold">What logo formats do you support?</p><span class="index-module__OW0Mba__iconWrapper" aria-hidden="true"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-lg"><svg data-prefix="fal" data-icon="plus" class="svg-inline--fa fa-plus " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M240 48c0-8.8-7.2-16-16-16s-16 7.2-16 16l0 192-192 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l192 0 0 192c0 8.8 7.2 16 16 16s16-7.2 16-16l0-192 192 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-192 0 0-192z"></path></svg></span></span></div><div class="index-module__OW0Mba__body index-module__OW0Mba__variant-primary" aria-label="What logo formats do you support?" role="region"><div><div><div><p>Logos are delivered in SVG when available, with PNG conversions for broader compatibility. If SVG isn&#39;t available, you get the highest-quality PNG we can find, with a transparent background. See <a href="https://docs.brandfetch.com/reference/brand-api" target="_blank" rel="noopener noreferrer">our docs</a> for more details.</p></div></div></div></div></div><div class="index-module__OW0Mba__collapse-item index-module__OW0Mba__variant-primary"><div class="index-module__OW0Mba__header index-module__OW0Mba__variant-primary" aria-expanded="false" role="button" tabindex="0"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B1 index-module-scss-module__LupDFW__weight-semibold">How do I request a brand update?</p><span class="index-module__OW0Mba__iconWrapper" aria-hidden="true"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-lg"><svg data-prefix="fal" data-icon="plus" class="svg-inline--fa fa-plus " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M240 48c0-8.8-7.2-16-16-16s-16 7.2-16 16l0 192-192 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l192 0 0 192c0 8.8 7.2 16 16 16s16-7.2 16-16l0-192 192 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-192 0 0-192z"></path></svg></span></span></div><div class="index-module__OW0Mba__body index-module__OW0Mba__variant-primary" aria-label="How do I request a brand update?" role="region"><div><div><div><p>Submit your request at <a href="https://brandfetch.com/update?mode=web" target="_blank" rel="noopener noreferrer">brandfetch.com/update</a>. Our QA team will update the brand with its latest information.</p></div></div></div></div></div><div class="index-module__OW0Mba__collapse-item index-module__OW0Mba__variant-primary"><div class="index-module__OW0Mba__header index-module__OW0Mba__variant-primary" aria-expanded="false" role="button" tabindex="0"><p class="index-module-scss-module__LupDFW__paragraph index-module-scss-module__LupDFW__level-B1 index-module-scss-module__LupDFW__weight-semibold">Do you offer discounts for startups or nonprofits?</p><span class="index-module__OW0Mba__iconWrapper" aria-hidden="true"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-lg"><svg data-prefix="fal" data-icon="plus" class="svg-inline--fa fa-plus " role="img" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M240 48c0-8.8-7.2-16-16-16s-16 7.2-16 16l0 192-192 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l192 0 0 192c0 8.8 7.2 16 16 16s16-7.2 16-16l0-192 192 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-192 0 0-192z"></path></svg></span></span></div><div class="index-module__OW0Mba__body index-module__OW0Mba__variant-primary" aria-label="Do you offer discounts for startups or nonprofits?" role="region"><div><div><div><p>Yes. Qualified startups and nonprofits get 40% off paid plans for the first 12 months. <a href="https://brandfetch.com/developers/contact/sales">Reach out to sales</a> to apply.</p></div></div></div></div></div></div></div></div></section></main><section class="index-module-scss-module__GUXqXq__section index-module-scss-module__GUXqXq__variant-transparent index-module-scss-module__GUXqXq__overflow-hidden index-module-scss-module__GUXqXq__top-15 index-module-scss-module__GUXqXq__bottom-15"><div class="index-module__1m1j5G__wrapper"><div class="index-module-scss-module__1vxd5W__flex index-module-scss-module__1vxd5W__display-flex index-module-scss-module__1vxd5W__direction-column index-module-scss-module__1vxd5W__justify-start index-module-scss-module__1vxd5W__align-normal index-module-scss-module__1vxd5W__gap-0 index-module-scss-module__1vxd5W__gap-x-0 index-module-scss-module__1vxd5W__gap-y-4 index-module-scss-module__1vxd5W__width-full index-module-scss-module__1vxd5W__overflow-hidden index-module-scss-module__1vxd5W__wrap-nowrap index-module__UAk_yq__smoothCarousels index-module__UAk_yq__vignette"><div class="index-module__UAk_yq__smoothCarousel"><div class="index-module__UAk_yq__track" style="--scroll-end:-950px;width:1900px;--start-at:0px;--speed:44s"><div class="index-module__UAk_yq__slide" style="margin:0 35px;height:20px"><div class="index-module__XrMpBa__item"><span class="index-module-scss-module__r1Ax4q__icon index-module-scss-module__r1Ax4q__size-sm"><svg data-prefix="fal" data-icon="file-shield" class="svg-inline--fa fa-file-shield " role="img" viewBox="0 0 576 512" aria-hidden="true"><path fill="currentColor" d="M224 32L96 32C78.3 32 64 46.3 64 64l0 384c0 17.7 14.3 32 32 32l178.3 0c6.8 11.3