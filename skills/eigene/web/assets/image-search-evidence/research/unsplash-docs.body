    <span class="p">}</span>
  <span class="p">},</span>
  <span class="c1">// ... more photos</span>
<span class="p">]</span>

</code></pre></div></div>

<h3 id="get-a-photo">Get a photo</h3>

<p>Retrieve a single photo.</p>

<pre><code>GET /photos/:id
</code></pre>

<p><em>Note</em>: See the note on <a href="#hotlinking">hotlinking</a>.</p>

<h4 id="parameters-7">Parameters</h4>

<table>
  <thead>
    <tr>
      <th>param</th>
      <th>Description</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><code>id</code></td>
      <td>The photo’s ID. Required.</td>
    </tr>
  </tbody>
</table>

<h4 id="response-7">Response</h4>

<pre><code>200 OK
X-Ratelimit-Limit: 1000
X-Ratelimit-Remaining: 999
</code></pre>

<div class="language-javascript highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="p">{</span>
