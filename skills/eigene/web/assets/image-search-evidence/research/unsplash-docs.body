  <span class="dl">"</span><span class="s2">location</span><span class="dl">"</span><span class="p">:</span> <span class="dl">"</span><span class="s2">Montreal, Qc</span><span class="dl">"</span><span class="p">,</span>
  <span class="dl">"</span><span class="s2">total_collections</span><span class="dl">"</span><span class="p">:</span> <span class="mi">5</span><span class="p">,</span>
