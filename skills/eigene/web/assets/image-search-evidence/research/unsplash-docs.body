  <span class="dl">"</span><span class="s2">color</span><span class="dl">"</span><span class="p">:</span> <span class="dl">"</span><span class="s2">#6E633A</span><span class="dl">"</span><span class="p">,</span>
  <span class="dl">"</span><span class="s2">blur_hash</span><span class="dl">"</span><span class="p">:</span> <span class="dl">"</span><span class="s2">LFC$yHwc8^$yIAS$%M%00KxukYIp</span><span class="dl">"</span><span class="p">,</span>
  <span class="dl">"</span><span class="s2">downloads</span><span class="dl">"</span><span class="p">:</span> <span class="mi">1345</span><span class="p">,</span>
  <span class="dl">"</span><span class="s2">description</span><span class="dl">"</span><span class="p">:</span> <span class="dl">"</span><span class="s2">A man drinking a coffee.</span><span class="dl">"</span><span class="p">,</span>
  <span class="dl">"</span><span class="s2">exif</span><span class="dl">"</span><span class="p">:</span> <span class="p">{</span>
    <span class="dl">"</span><span class="s2">make</span><span class="dl">"</span><span class="p">:</span> <span class="dl">"</span><span class="s2">Canon</span><span class="dl">"</span><span class="p">,</span>
    <span class="dl">"</span><span class="s2">model</span><span class="dl">"</span><span class="p">:</span> <span class="dl">"</span><span class="s2">Canon EOS 40D</span><span class="dl">"</span><span class="p">,</span>
    <span class="dl">"</span><span class="s2">exposure_time</span><span class="dl">"</span><span class="p">:</span> <span class="dl">"</span><span class="s2">0.011111111111111112</span><span class="dl">"</span><span class="p">,</span>
    <span class="dl">"</span><span class="s2">aperture</span><span class="dl">"</span><span class="p">:</span> <span class="dl">"</span><span class="s2">4.970854</span><span class="dl">"</span><span class="p">,</span>
    <span class="dl">"</span><span class="s2">focal_length</span><span class="dl">"</span><span class="p">:</span> <span class="dl">"</span><span class="s2">37</span><span class="dl">"</span><span class="p">,</span>
    <span class="dl">"</span><span class="s2">iso</span><span class="dl">"</span><span class="p">:</span> <span class="mi">100</span>
