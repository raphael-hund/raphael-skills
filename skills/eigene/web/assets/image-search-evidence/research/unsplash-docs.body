<h3 id="search-users">Search users</h3>

<p>Get a single page of user results for a query.</p>

<pre><code>GET /search/users
</code></pre>

<h4 id="parameters-14">Parameters</h4>

<table>
  <thead>
    <tr>
      <th>param</th>
      <th>Description</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><code>query</code></td>
      <td>Search terms.</td>
    </tr>
    <tr>
      <td><code>page</code></td>
      <td>Page number to retrieve. (Optional; default: 1)</td>
    </tr>
    <tr>
      <td><code>per_page</code></td>
      <td>Number of items per page. (Optional; default: 10)</td>
    </tr>
  </tbody>
</table>

<h4 id="response-14">Response</h4>

<pre><code>200 OK
Link: &lt;https://api.unsplash.com/search/users?page=1&amp;query=nas&gt;; rel="first", &lt;https://api.unsplash.com/search/users?page=1&amp;query=nas&gt;; rel="prev", &lt;https://api.unsplash.com/search/users?page=3&amp;query=nas&gt;; rel="last", &lt;https://api.unsplash.com/search/users?page=3&amp;query=nas&gt;; rel="next"
X-Ratelimit-Limit: 1000
X-Ratelimit-Remaining: 999
</code></pre>

